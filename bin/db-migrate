#!/usr/bin/env bash

[[ "$TRACE" ]] && set -o xtrace
set -o errexit
set -o nounset
set -o pipefail
set -o noclobber

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
run_task="${DB_MIGRATE_RUN_TASK:-$script_dir/run-task}"

app_name=""
environment=""
ref=""
previous_ref=""

usage() {
  cat <<EOF
Usage: db-migrate --app-name APP --environment ENV --ref REF [--previous-ref PREVIOUS_REF]

Runs the ECS database migration task for a deployed Tariff app.

If --previous-ref is given and no file under db/migrate, db/data_migrate,
or db/data_migrations changed between that ref and REF, the migration
tasks are skipped: the deployment currently running already applied every
migration in REF.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --app-name)
      app_name="$2"
      shift 2
      ;;
    --environment)
      environment="$2"
      shift 2
      ;;
    --ref)
      ref="$2"
      shift 2
      ;;
    --previous-ref)
      previous_ref="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if [[ -z "$app_name" || -z "$environment" || -z "$ref" ]]; then
  usage >&2
  exit 1
fi

# Return success only when we can positively determine that no file under
# the schema or data migration directories differs between the two refs.
# Watch db/data_migrations (backend) and db/data_migrate (data_migrate gem).
# Return failure (run the migrations) when files differ or the comparison
# cannot be made, for example when this is not a git checkout or a ref does
# not resolve.
migration_pathspecs=(db/migrate db/data_migrate db/data_migrations)

migrations_unchanged() {
  local previous="$1"
  local current="$2"
  local changed

  git rev-parse --quiet --verify "${previous}^{commit}" >/dev/null || return 1
  git rev-parse --quiet --verify "${current}^{commit}" >/dev/null || return 1

  changed="$(git diff --name-only "$previous" "$current" -- "${migration_pathspecs[@]}")" || return 1
  [[ -z "$changed" ]]
}

if [[ -n "$previous_ref" ]] && migrations_unchanged "$previous_ref" "$ref"; then
  echo "::notice::No files changed under db/migrate, db/data_migrate, or db/data_migrations between ${previous_ref} and ${ref}. Skipping the database migration tasks."
  exit 0
fi

repo="${app_name#tariff-}"
task="${repo}-job"

cd terraform

terraform init -backend-config="backends/${environment}.tfbackend"

TF_VAR_docker_tag="$ref" terraform apply \
  -var-file="config_${environment}.tfvars" \
  -auto-approve \
  -lock-timeout=10m \
  -target="module.${task}"

task_definition_arn=$(terraform state show "module.${task}.aws_ecs_task_definition.this" \
  | awk -F'= ' '/^[[:space:]]*arn[[:space:]]+=/ { gsub(/"/, "", $2); print $2; exit }')

if [[ -z "$task_definition_arn" ]]; then
  echo "Could not determine updated task definition ARN" >&2
  exit 1
fi

cd ..

if [[ "$repo" != "backend" ]]; then
  echo "::notice::Running migration task in $environment..."
  "$run_task" \
    -e "$environment" \
    -t "$task" \
    -d "$task_definition_arn" \
    -o '{"containerOverrides":[{"name":"'"$task"'","command":["/bin/sh","-c","bundle exec rails db:migrate"]}]}'
  exit 0
fi

# The UK and XI migration tasks target different schemas with the same image
# and have no dependency between them, so run them in parallel and fail the
# step if either task fails. Capture each task's output so the logs stay
# attributed to one schema rather than interleaving on stdout.
run_backend_migration() {
  local service="$1"
  local label

  label="$(printf '%s' "$service" | tr '[:lower:]' '[:upper:]')"
  echo "::notice::Running migration task for ${label} schema in $environment..."
  "$run_task" \
    -e "$environment" \
    -t "$task" \
    -d "$task_definition_arn" \
    -o '{"containerOverrides":[{"name":"'"$task"'","environment":[{"name":"SERVICE","value":"'"$service"'"}],"command":["/bin/sh","-c","bundle exec rails db:migrate && bundle exec rails data:migrate"]}]}'
}

uk_log="$(mktemp)"
xi_log="$(mktemp)"
trap 'rm -f "$uk_log" "$xi_log"' EXIT

run_backend_migration uk >|"$uk_log" 2>&1 &
uk_pid=$!
run_backend_migration xi >|"$xi_log" 2>&1 &
xi_pid=$!

status=0
wait "$uk_pid" || status=1
cat "$uk_log"
wait "$xi_pid" || status=1
cat "$xi_log"
exit "$status"
